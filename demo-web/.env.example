PUBLIC_API_URL=http://localhost:3000

# Server-only — never exposed to the browser. Used by src/pages/api/* to
# proxy map/route requests to the pulgarcito API without shipping the key to clients.
PULGARCITO_API_KEY=replace-with-a-verified-user-api-key

# Optional, server-only. Overrides PUBLIC_API_URL for the server-side proxy
# only (src/lib/api-proxy.ts) — read at runtime via process.env, not baked in
# at build time. Needed when the proxy's target differs from what the browser
# uses, e.g. Docker Compose: "http://api:3000" (Compose service name) here,
# vs. PUBLIC_API_URL="http://localhost:3000" for the browser. Leave unset for
# local dev, where they're the same.
# INTERNAL_API_URL=http://api:3000
